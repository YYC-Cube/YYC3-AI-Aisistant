# ════════════════════════════════════════════════════════════════════
# YYC³ AI Family - 环境变量配置模板
# ════════════════════════════════════════════════════════════════════
# Version: 0.9.4 [Personalize]
#
# 使用方式:
#   cp .env.example .env
#   编辑 .env 填入实际值
#
# 密码生成: openssl rand -base64 32
# ════════════════════════════════════════════════════════════════════

# ──────────── PostgreSQL 连接配置 ────────────
YYC3_PG_HOST=localhost
YYC3_PG_PORT=5432
YYC3_PG_DATABASE=yyc3_family
YYC3_PG_USER=yyc3_admin
YYC3_PG_PASSWORD=
YYC3_PG_SSL=prefer
YYC3_PG_POOL_SIZE=10

# ──────────── API 代理服务配置 ────────────
YYC3_PORT=3721
YYC3_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174
YYC3_LOG_LEVEL=info

# ──────────── 认证配置 ────────────
# 留空 = 无认证（本地开发模式）
# 生产环境请设置 >= 32 字符随机字符串
YYC3_AUTH_TOKEN=

# ──────────── Vite 前端配置 ────────────
VITE_API_PROXY_URL=http://localhost:3721

# ──────────── Docker Compose 模式 ────────────
# Docker 环境下自动覆盖:
#   YYC3_PG_HOST=yyc3-postgres
#   YYC3_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
